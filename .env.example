# Copia orientativa. scripts/preparar-configuracion.ps1 crea una clave local aleatoria.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=entrepares_development
POSTGRES_USER=entrepares_dev
POSTGRES_PASSWORD=
POSTGRES_TEST_DB=entrepares_test
POSTGRES_TEST_USER=entrepares_test
POSTGRES_TEST_PASSWORD=
POSTGRES_TEST_DB_NAME=test_entrepares
# Lo completa postgresql_local.py preparar para reconocer el cluster privado.
POSTGRES_TEST_CLUSTER_NAME=
